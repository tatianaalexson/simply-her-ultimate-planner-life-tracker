{
  "name": "FitnessSetting",
  "type": "object",
  "properties": {
    "kind": {
      "type": "string",
      "default": "fitness"
    },
    "detail_level": {
      "type": "string",
      "enum": [
        "simple",
        "balanced",
        "advanced"
      ],
      "default": "balanced"
    },
    "fitness_focuses": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": [
        "general"
      ]
    },
    "unit_system": {
      "type": "string",
      "enum": [
        "metric",
        "imperial"
      ],
      "default": "metric"
    },
    "weight_unit": {
      "type": "string",
      "enum": [
        "kg",
        "lb"
      ],
      "default": "kg"
    },
    "distance_unit": {
      "type": "string",
      "enum": [
        "km",
        "mi"
      ],
      "default": "km"
    },
    "water_unit": {
      "type": "string",
      "default": "cups"
    },
    "default_location": {
      "type": "string",
      "default": "home"
    },
    "default_rest_seconds": {
      "type": "number",
      "default": 60
    },
    "experience_levels": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "category": {
            "type": "string"
          },
          "level": {
            "type": "string"
          }
        }
      },
      "default": []
    },
    "steps_goal": {
      "type": "number",
      "default": 8000
    },
    "water_goal": {
      "type": "number",
      "default": 8
    },
    "active_goal": {
      "type": "number",
      "default": 30
    },
    "sleep_goal": {
      "type": "number",
      "default": 4
    },
    "calorie_goal": {
      "type": "number",
      "default": 2000
    },
    "protein_goal": {
      "type": "number",
      "default": 120
    },
    "carbs_goal": {
      "type": "number",
      "default": 200
    },
    "fat_goal": {
      "type": "number",
      "default": 65
    },
    "wearable": {
      "type": "boolean",
      "default": false
    }
  },
  "required": [
    "kind"
  ]
}