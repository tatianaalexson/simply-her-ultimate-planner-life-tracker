{
  "name": "FitnessDaily",
  "type": "object",
  "properties": {
    "log_date": {
      "type": "string",
      "format": "date"
    },
    "steps": {
      "type": "number",
      "default": 0
    },
    "steps_source": {
      "type": "string",
      "enum": [
        "manual",
        "health_connect",
        "google_health",
        "device",
        "simply_her"
      ],
      "default": "manual",
      "description": "Provenance: where the steps value originated"
    },
    "water": {
      "type": "number",
      "default": 0
    },
    "water_source": {
      "type": "string",
      "enum": [
        "manual",
        "health_connect",
        "google_health",
        "device",
        "simply_her"
      ],
      "default": "manual"
    },
    "active": {
      "type": "number",
      "default": 0
    },
    "active_source": {
      "type": "string",
      "enum": [
        "manual",
        "health_connect",
        "google_health",
        "device",
        "simply_her"
      ],
      "default": "manual"
    },
    "sleep": {
      "type": "number",
      "default": 0
    },
    "sleep_source": {
      "type": "string",
      "enum": [
        "manual",
        "health_connect",
        "google_health",
        "device",
        "simply_her"
      ],
      "default": "manual"
    },
    "energy": {
      "type": "number",
      "default": 0
    },
    "energy_source": {
      "type": "string",
      "enum": [
        "manual",
        "health_connect",
        "google_health",
        "device",
        "simply_her"
      ],
      "default": "manual"
    },
    "rest_day": {
      "type": "boolean",
      "default": false
    },
    "soreness": {
      "type": "number",
      "default": 0
    },
    "motivation": {
      "type": "number",
      "default": 0
    },
    "capacity_today": {
      "type": "string"
    },
    "capacity_notes": {
      "type": "string"
    },
    "post_activity_response": {
      "type": "string"
    },
    "distance": {
      "type": "number",
      "default": 0
    },
    "distance_source": {
      "type": "string",
      "enum": [
        "manual",
        "health_connect",
        "google_health",
        "device",
        "simply_her"
      ],
      "default": "manual"
    },
    "sleep_quality": {
      "type": "number",
      "default": 0
    },
    "bedtime": {
      "type": "string"
    },
    "wake_time": {
      "type": "string"
    },
    "energy_budget_used": {
      "type": "number",
      "default": 0
    },
    "last_synced_at": {
      "type": "string",
      "description": "ISO timestamp of the last external provider sync that updated this daily record"
    }
  },
  "required": [
    "log_date"
  ]
}