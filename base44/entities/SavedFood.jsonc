{
  "name": "SavedFood",
  "type": "object",
  "properties": {
    "name": {
      "type": "string"
    },
    "brand": {
      "type": "string"
    },
    "barcode": {
      "type": "string"
    },
    "category": {
      "type": "string",
      "default": "Other"
    },
    "favourite": {
      "type": "boolean",
      "default": false
    },
    "serving_size": {
      "type": "number",
      "default": 1
    },
    "serving_unit": {
      "type": "string",
      "default": "serving"
    },
    "servings_per_container": {
      "type": "number",
      "default": 1
    },
    "calories": {
      "type": "number",
      "default": 0
    },
    "protein": {
      "type": "number",
      "default": 0
    },
    "carbs": {
      "type": "number",
      "default": 0
    },
    "fat": {
      "type": "number",
      "default": 0
    },
    "fibre": {
      "type": "number",
      "default": 0
    },
    "sugar": {
      "type": "number",
      "default": 0
    },
    "sodium": {
      "type": "number",
      "default": 0
    },
    "saturated_fat": {
      "type": "number",
      "default": 0
    },
    "cholesterol": {
      "type": "number",
      "default": 0
    },
    "potassium": {
      "type": "number",
      "default": 0
    },
    "calcium": {
      "type": "number",
      "default": 0
    },
    "iron": {
      "type": "number",
      "default": 0
    },
    "notes": {
      "type": "string"
    }
  },
  "required": [
    "name"
  ]
}