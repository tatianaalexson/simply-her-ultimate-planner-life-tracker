{
  "name": "NutritionEntry",
  "type": "object",
  "properties": {
    "name": {
      "type": "string"
    },
    "calories": {
      "type": "number",
      "default": 0
    },
    "protein": {
      "type": "number",
      "default": 0
    },
    "carbs": {
      "type": "number",
      "default": 0
    },
    "fat": {
      "type": "number",
      "default": 0
    },
    "log_date": {
      "type": "string",
      "format": "date"
    }
  },
  "required": [
    "log_date"
  ]
}