{
  "name": "KitchenItem",
  "type": "object",
  "properties": {
    "name": {
      "type": "string"
    },
    "category": {
      "type": "string",
      "enum": [
        "appliance",
        "cookware",
        "bakeware",
        "utensil",
        "tool",
        "food_storage",
        "specialty",
        "custom"
      ],
      "default": "tool"
    },
    "custom_category": {
      "type": "string"
    },
    "qty": {
      "type": "number",
      "default": 1
    },
    "brand": {
      "type": "string"
    },
    "model": {
      "type": "string"
    },
    "storage_location": {
      "type": "string"
    },
    "purchase_date": {
      "type": "string",
      "format": "date"
    },
    "purchase_price": {
      "type": "number",
      "default": 0
    },
    "warranty_expiration": {
      "type": "string",
      "format": "date"
    },
    "notes": {
      "type": "string"
    },
    "favourite": {
      "type": "boolean",
      "default": false
    },
    "status": {
      "type": "string",
      "enum": [
        "active",
        "stored",
        "replaced",
        "donated",
        "discarded"
      ],
      "default": "active"
    },
    "photo_url": {
      "type": "string"
    }
  },
  "required": [
    "name"
  ]
}