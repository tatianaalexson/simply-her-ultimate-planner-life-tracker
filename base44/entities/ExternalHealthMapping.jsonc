{
  "name": "ExternalHealthMapping",
  "type": "object",
  "properties": {
    "provider": {
      "type": "string",
      "enum": [
        "health_connect",
        "google_health"
      ]
    },
    "data_type": {
      "type": "string",
      "description": "Health data type ID (steps, sleep, exercise_sessions, etc.)"
    },
    "external_id": {
      "type": "string",
      "description": "Provider's unique record identifier"
    },
    "external_updated_at": {
      "type": "string",
      "description": "When the provider last updated this external record"
    },
    "source_app": {
      "type": "string",
      "description": "Origin app where available (Fitbit, Pixel Watch, Samsung Health, etc.)"
    },
    "simply_her_entity": {
      "type": "string",
      "description": "Simply Her entity name the external record maps to (WorkoutSession, FitnessDaily, NutritionEntry, etc.)"
    },
    "simply_her_record_id": {
      "type": "string",
      "description": "Simply Her record ID that corresponds to this external record"
    },
    "sync_hash": {
      "type": "string",
      "description": "Deterministic hash for deduplication matching"
    },
    "sync_direction": {
      "type": "string",
      "enum": [
        "imported",
        "exported"
      ],
      "default": "imported"
    },
    "last_synced_at": {
      "type": "string"
    },
    "is_reconciled": {
      "type": "boolean",
      "default": false,
      "description": "Whether this record has been reconciled against other providers"
    },
    "reconciled_with": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": [],
      "description": "Other ExternalHealthMapping IDs this record was reconciled with"
    }
  },
  "required": [
    "provider",
    "data_type",
    "external_id"
  ]
}