{
  "name": "ExternalHealthMapping",
  "type": "object",
  "properties": {
    "provider": {
      "type": "string",
      "enum": [
        "health_connect",
        "google_health",
        "apple_health"
      ]
    },
    "data_type": {
      "type": "string",
      "description": "Health data type ID (steps, sleep, exercise_sessions, etc.)"
    },
    "external_id": {
      "type": "string",
      "description": "Provider's unique record identifier"
    },
    "external_updated_at": {
      "type": "string"
    },
    "source_app": {
      "type": "string",
      "description": "Origin app where available (Apple Health, Fitbit, Pixel Watch, etc.)"
    },
    "source_device": {
      "type": "string",
      "description": "Originating device where available (iPhone, Apple Watch, etc.)"
    },
    "simply_her_entity": {
      "type": "string"
    },
    "simply_her_record_id": {
      "type": "string"
    },
    "sync_hash": {
      "type": "string"
    },
    "sync_direction": {
      "type": "string",
      "enum": [
        "imported",
        "exported"
      ],
      "default": "imported"
    },
    "last_synced_at": {
      "type": "string"
    },
    "is_reconciled": {
      "type": "boolean",
      "default": false
    },
    "reconciled_with": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": []
    }
  },
  "required": [
    "provider",
    "data_type",
    "external_id"
  ]
}